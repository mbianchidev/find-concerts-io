{
  "name": "find-concerts-io",
  "version": "1.0.0",
  "description": "A modern, responsive web application for discovering music events worldwide. Built with Next.js, TypeScript, and Tailwind CSS.",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/server.ts dev",
    "build": "next build",
    "start": "node --import tsx scripts/server.ts start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:seed": "tsx tests/seed.ts",
    "test:load": "tsx scripts/load-test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scrape": "tsx scripts/scrape.ts",
    "worker": "tsx scripts/worker.ts",
    "import:workbook": "tsx scripts/import-workbook.ts",
    "account:admin": "tsx scripts/admin.ts",
    "prepare": "node .husky/install.mjs"
  },
  "keywords": [
    "concerts",
    "events",
    "music",
    "nextjs",
    "typescript"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@sentry/node": "^11.11.0",
    "@tanstack/react-query": "^5.107.1",
    "cheerio": "^1.2.0",
    "next": "^16.4.3",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "robots-parser": "^3.0.1",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "write-excel-file": "^4.1.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.11.1": true
  }
}
