APP_ORIGIN=http://localhost:3000
DATABASE_PATH=.data/concerts.sqlite
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Only enable behind a trusted reverse proxy that replaces/appends forwarding headers.
TRUST_PROXY=false
# Starting the server also starts its worker. Default: collect every six hours.
# Set this to an empty value for queue-only operation without website requests.
SCRAPE_INTERVAL_MINUTES=360

# Required deployment-specific private contact channel before a public launch.
PRIVACY_CONTACT=

# Optional external providers. Never expose these through NEXT_PUBLIC variables.
# Public venue lookups only, after Show venue map. Empty disables geocoding.
# Use a compatible search endpoint to switch providers without a code change.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TICKETMASTER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SENTRY_DSN=
